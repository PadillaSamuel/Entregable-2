# --- SISTEMA OPERATIVO ---
# Archivos específicos del sistema que no aportan al proyecto
.DS_Store
Thumbs.db
desktop.ini

# --- DEPENDENCIAS ---
# Carpetas de paquetes que se pueden reconstruir (¡nunca las subas!)
node_modules/
bower_components/
jspm_packages/
.pnp/

# --- ENTORNO Y CONFIGURACIÓN LOCAL ---
# Archivos que contienen contraseñas, llaves API o configuraciones locales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# --- COMPILACIÓN Y PRODUCCIÓN ---
# Carpetas donde se guarda el código procesado o listo para producción
dist/
build/
out/
.next/
.nuxt/

# --- LOGS Y CACHÉ ---
# Registros de errores y archivos temporales de ejecución
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/

# --- EDITORES DE CÓDIGO ---
# Configuraciones de tu editor personal (VS Code, IntelliJ, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
