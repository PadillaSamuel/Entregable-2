<main class="chat-app">
  <section class="ads">
    <h2>ADS</h2>
    <ul>
      {{#each publicity}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>

  <div class="user">
    <label for="name">USERNAME:</label>
    <input id="name" type="text" placeholder="Write your name" maxlength="30" autocomplete="off" required>
  </div>

  <form id="form-chat" class="form-chat">
    <label for="message">MESSAGE:</label>
    <input id="message" type="text" placeholder="Write a message" maxlength="500" autocomplete="off" required>
    <button type="submit" class="btn-send">SEND</button>
  </form>

  <section id="chat" class="chat">
    {{#each messages}}
      <div class="msg">
        <div class="msg-header">
          <strong>{{name}}</strong>
          <span class="hour">{{hour}}</span>
        </div>
        <p>{{text}}</p>
      </div>
    {{else}}
      <p id="empty" class="empty">No messages yet. Write the first one!</p>
    {{/each}}
  </section>
</main>
